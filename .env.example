# Copy this file to .env and fill in real values for local testing.
# .env is gitignored -- it never gets committed.

# --- LLM (required to run the Supervisor/Research/Writer/Synthesis agents) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Tools ---
# Leave blank to use the search MCP server's built-in mock results (offline demo).
TAVILY_API_KEY=

# --- Database ---
# MongoDB Atlas connection string (free M0 tier is fine).
# Leave blank to fall back to the in-memory store (dev/demo only, no persistence).
MONGODB_URI=
MONGODB_DB=taskos

# --- Runtime ---
MAX_TASK_RETRIES=3
MAX_PARALLEL_TASKS=4
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated origins allowed to call the API/websocket.
# Required for the frontend to reach this API at all -- there is no wildcard
# fallback. Locally: http://localhost:5173 (Vite's default dev port).
# In production: your deployed frontend's exact URL, e.g.
# https://taskos-frontend.onrender.com -- no trailing slash, one exact origin
# per entry, comma-separate if you ever need more than one.
ALLOWED_ORIGINS=http://localhost:5173
