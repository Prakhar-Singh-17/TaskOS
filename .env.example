# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Tools ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Database ---
# MongoDB Atlas connection string (free M0 tier is fine).
# Leave blank to fall back to the in-memory store (dev/demo only).
MONGODB_URI=
MONGODB_DB=taskos

# --- Runtime ---
MAX_TASK_RETRIES=3
MAX_PARALLEL_TASKS=4
API_HOST=127.0.0.1
API_PORT=8000
